{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "functions": {
    "api/index.js": { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/v1/cron/daily",
      "schedule": "0 1 * * *"
    }
  ]
}
