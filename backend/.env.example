# ---- Server ----
# Railway/Render tự gán PORT; giữ 5000 cho local + Docker.
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ---- Supabase ----
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE=your-service-role-key

# ---- JWT ----
# Dùng để sign/verify access token nội bộ. Tối thiểu 32 ký tự.
JWT_SECRET=replace-with-strong-secret-at-least-32-chars

# ---- Vercel Cron ----
# Bảo vệ endpoint GET /api/v1/cron/daily (tối thiểu 16 ký tự).
# Trên Vercel, đặt biến này làm CRON_SECRET để Vercel Cron tự gắn Bearer token.
CRON_SECRET=replace-with-random-secret-min-16-chars

JWT_SECRET=replace-with-strong-secret-at-least-32-chars

# ---- Cloudinary ----
# Định dạng: cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ---- Zalo OA ----
ZALO_OA_ID=your-zalo-oa-id
ZALO_ACCESS_TOKEN=your-zalo-oa-access-token

# ---- Gmail SMTP ----
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
