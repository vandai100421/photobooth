# Frontend environment variables
#
# Local dev: để trống hoặc dùng /api/v1 (Vite proxy sang backend port 5000).
# Production: trỏ tới backend URL thật, ví dụ https://api.tap-photobooth.com/api/v1
VITE_API_URL=/api/v1
# VITE_API_URL=https://api.tap-photobooth.com/api/v1

# Sentry DSN (frontend) — lấy từ sentry.io. Để trống để tắt monitoring.
# VITE_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
VITE_SENTRY_DSN=
